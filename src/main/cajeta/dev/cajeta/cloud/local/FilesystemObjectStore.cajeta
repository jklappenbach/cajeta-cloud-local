package dev.cajeta.cloud.local;

import cajeta.collection.ArrayList;
import cajeta.concurrent.Lock;
import cajeta.concurrent.LockGuard;
import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.time.Clock;
import dev.cajeta.cloud.Capabilities;
import dev.cajeta.cloud.Caps;
import dev.cajeta.cloud.CloudException;
import dev.cajeta.cloud.CloudStats;
import dev.cajeta.cloud.object.CondResult;
import dev.cajeta.cloud.object.ListPage;
import dev.cajeta.cloud.object.MultipartUpload;
import dev.cajeta.cloud.object.ObjectReader;
import dev.cajeta.cloud.object.ObjectStore;
import dev.cajeta.cloud.object.ObjectWriter;
import dev.cajeta.cloud.object.StatResult;
import dev.cajeta.crypto.HmacSha256;
import dev.cajeta.crypto.SecureRandom;

/**
 * cajeta-cloud's object-store port over a directory (adapters spec §4), for
 * development and tests: no account, no network.
 *
 * Every key is one file under `<root>/objects`, one directory per `/`
 * segment, each segment percent-encoded so any key is a legal name on
 * Linux, macOS and Windows and keys differing only in case stay distinct on
 * a case-insensitive filesystem; files end `=o` and directories `=d`, so `a`
 * and `a/b` coexist. A key with a `.` or `..` segment, or an empty key, is
 * refused. The object's metadata (content type, etag, modified time) is a
 * header in the same file rather than a sidecar, so one temp-and-rename
 * (`File.writeAllBytes`) installs data and metadata together: a put
 * interrupted before its rename leaves the previous object whole.
 *
 * Dev-grade (§4.3): one lock in the process serializes writes and
 * conditional checks, which makes conditional writes correct for one process
 * only. The capability document says so (`object.dev-grade`), so a
 * deployment requiring more fails at startup. Listing walks the tree and
 * pages exactly as the memory driver does.
 */
public final class FilesystemObjectStore implements ObjectStore {
    private static final String MAGIC = "CJO1";

    String root;
    String objects;
    String uploads;
    Lock lock;
    Capabilities caps;
    CloudStats statsObj;

    /** The grade this driver declares. */
    public static #String DEV_GRADE() { return "" + "object.dev-grade"; }

    public FilesystemObjectStore(String root) {
        this.root = "" + root;
        this.objects #= root + "/objects";
        this.uploads #= root + "/uploads";
        Path o #= Path.of(this.objects);
        o.mkdirs();
        Path u #= Path.of(this.uploads);
        u.mkdirs();
        this.lock = heap Lock();
        this.statsObj = heap CloudStats();
        Capabilities c = heap Capabilities("filesystem");
        String grade #= FilesystemObjectStore.DEV_GRADE();
        c.declare(grade, "one process: conditional writes hold an in-process lock, not a file lock");
        c.declare(Caps.COND_PUT_CREATE(), "within one process");
        c.declare(Caps.COND_PUT_OVERWRITE(), "within one process");
        c.declare(Caps.SERVER_SIDE_COPY(), "");
        c.declare(Caps.LIST_ORDERED(), "");
        c.declare(Caps.READ_AFTER_WRITE(), "strong within one process");
        c.declare(Caps.MULTIPART(), "parts are staged as files under <root>/uploads");
        c.declare(Caps.RANGE_READ(), "");
        this.caps #= c;
        return;
    }

    public Capabilities capabilities() { return this.caps; }
    public CloudStats stats() { return this.statsObj; }

    /** The file that holds `key` under `root`. */
    public static #String fileFor(String root, String key) {
        String rel #= FilesystemObjectStore.relative(key, "fileFor");
        return root + "/objects/" + rel;
    }

    public #String put(String key, int8[] bytes, String contentType) {
        String file #= this.fileOf(key, "put");
        LockGuard g #= this.lock.acquire();
        String etag #= this.install(file, bytes, bytes.count(), contentType);
        this.statsObj.recordCall(0L, bytes.count(), 0L, false);
        return #etag;
    }

    public #int8[] get(String key) {
        String file #= this.fileOf(key, "get");
        LockGuard g #= this.lock.acquire();
        int8[] all #= File.readAllBytes(file);
        if (all == null) this.notFound("get", key);
        int64 off = FilesystemObjectStore.headerLength(all);
        int64 n = all.count() - off;
        int8[] out = heap int8[n];
        for (int64 i = 0L; i < n; i++) out[i] = all[off + i];
        this.statsObj.recordCall(0L, 0L, n, false);
        return #out;
    }

    public #StatResult stat(String key) {
        String file #= this.fileOf(key, "stat");
        LockGuard g #= this.lock.acquire();
        int8[] all #= File.readAllBytes(file);
        if (all == null) {
            String noType #= "" + "";
            String noTag #= "" + "";
            return heap StatResult(false, 0L, #noType, 0L, #noTag);
        }
        int64 off = FilesystemObjectStore.headerLength(all);
        String ct #= FilesystemObjectStore.headerField(all, 1);
        String etag #= FilesystemObjectStore.headerField(all, 2);
        String mod #= FilesystemObjectStore.headerField(all, 3);
        return heap StatResult(true, all.count() - off, #ct, FilesystemObjectStore.number(mod), #etag);
    }

    public #int8[] getRange(String key, int64 offset, int64 length) {
        String file #= this.fileOf(key, "getRange");
        LockGuard g #= this.lock.acquire();
        Path p #= Path.of(file);
        if (!p.isFile()) this.notFound("getRange", key);
        File f #= File.open(file, OpenMode.READ);
        int8[] head = heap int8[4096];
        int64 got = f.read(head, 0L, 4096L);
        int64 off = FilesystemObjectStore.headerLengthIn(head, got);
        int64 size = f.size() - off;
        if (offset < 0L || length < 1L || offset >= size) {
            f.close();
            throw heap CloudException(CloudException.PROVIDER_ERROR(), "filesystem", "getRange", key,
                "unsatisfiable range: offset " + offset + " length " + length + " against size " + size);
        }
        int64 end = offset + length;
        if (end > size) end = size;
        int64 n = end - offset;
        int8[] out = heap int8[n];
        f.seek(off + offset);
        int64 filled = 0L;
        while (filled < n) {
            int64 r = f.read(out, filled, n - filled);
            if (r <= 0L) filled = n;
            else filled = filled + r;
        }
        f.close();
        this.statsObj.recordCall(0L, 0L, n, false);
        return #out;
    }

    public boolean delete(String key) {
        String file #= this.fileOf(key, "delete");
        LockGuard g #= this.lock.acquire();
        Path p #= Path.of(file);
        boolean existed = p.isFile();
        if (existed) p.delete();
        this.statsObj.recordCall(0L, 0L, 0L, false);
        return existed;
    }

    public #String copy(String srcKey, String dstKey) {
        String src #= this.fileOf(srcKey, "copy");
        String dst #= this.fileOf(dstKey, "copy");
        LockGuard g #= this.lock.acquire();
        int8[] all #= File.readAllBytes(src);
        if (all == null) this.notFound("copy", srcKey);
        int64 off = FilesystemObjectStore.headerLength(all);
        String ct #= FilesystemObjectStore.headerField(all, 1);
        int64 n = all.count() - off;
        int8[] data = heap int8[n];
        for (int64 i = 0L; i < n; i++) data[i] = all[off + i];
        return this.install(dst, data, n, ct);
    }

    public #ListPage list(String prefix, String delimiter, String token, int64 maxKeys) {
        if (maxKeys < 1L) {
            throw heap CloudException(CloudException.PROVIDER_ERROR(), "filesystem", "list", prefix,
                "maxKeys must be >= 1");
        }
        LockGuard g #= this.lock.acquire();
        ArrayList<String> sorted = heap ArrayList<String>();
        this.walk(this.objects, "", sorted);
        ArrayList<String> keys = heap ArrayList<String>();
        ArrayList<String> prefixes = heap ArrayList<String>();
        String next #= "" + "";
        // The memory driver's paging, step for step (cajeta-cloud MemoryObjectStore.list).
        int32 i = 0;
        while (i < sorted.count()) {
            String k = sorted.get(i);
            boolean afterToken = token.byteLength() == 0 || FilesystemObjectStore.less(token, k);
            if (afterToken && (prefix.byteLength() == 0 || k.startsWith(prefix))) {
                if (delimiter.byteLength() > 0) {
                    int64 dpos = FilesystemObjectStore.indexAfterPrefix(k, prefix, delimiter);
                    if (dpos >= 0L) {
                        String cp #= k.substring(0, (int32) dpos + delimiter.byteLength());
                        boolean seen = false;
                        for (int32 p = 0; p < prefixes.count(); p++) {
                            if (prefixes.get(p).equals(cp)) seen = true;
                        }
                        if (!seen) {
                            if ((int64) (keys.count() + prefixes.count()) >= maxKeys) {
                                next #= "" + sorted.get(i - 1);
                                i = sorted.count();
                            } else {
                                prefixes.add(#cp);
                            }
                        }
                        i = i + 1;
                    } else {
                        if ((int64) (keys.count() + prefixes.count()) >= maxKeys) {
                            next #= "" + sorted.get(i - 1);
                            i = sorted.count();
                        } else {
                            String kk = "" + k;
                            keys.add(#kk);
                            i = i + 1;
                        }
                    }
                } else {
                    if ((int64) keys.count() >= maxKeys) {
                        next #= "" + sorted.get(i - 1);
                        i = sorted.count();
                    } else {
                        String kk = "" + k;
                        keys.add(#kk);
                        i = i + 1;
                    }
                }
            } else {
                i = i + 1;
            }
        }
        int32 nk = keys.count();
        String[] ka = heap String[nk];
        int64[] sa = heap int64[nk];
        int64[] ma = heap int64[nk];
        String[] ea = heap String[nk];
        for (int32 t = 0; t < nk; t++) {
            String k = "" + keys.get(t);
            String file #= this.fileOf(k, "list");
            int8[] all #= File.readAllBytes(file);
            int64 off = FilesystemObjectStore.headerLength(all);
            sa[t] = all.count() - off;
            String mod #= FilesystemObjectStore.headerField(all, 3);
            ma[t] = FilesystemObjectStore.number(mod);
            String etag #= FilesystemObjectStore.headerField(all, 2);
            ea[t] #= etag;
            ka[t] #= k;
        }
        int32 np = prefixes.count();
        String[] pa = heap String[np];
        for (int32 t = 0; t < np; t++) {
            String q = "" + prefixes.get(t);
            pa[t] #= q;
        }
        this.statsObj.recordCall(0L, 0L, 0L, false);
        return heap ListPage(#ka, #sa, #ma, #ea, #pa, #next, true);
    }

    public #ObjectReader openRead(String key) {
        int8[] data #= this.get(key);
        return heap FilesystemReader(#data);
    }

    public #ObjectWriter openWrite(String key, String contentType) {
        String file #= this.fileOf(key, "openWrite");
        return heap FilesystemWriter(this, file, contentType);
    }

    public #MultipartUpload beginMultipart(String key, String contentType) {
        String file #= this.fileOf(key, "beginMultipart");
        int8[] idb #= SecureRandom.bytes(8L);
        String id #= HmacSha256.toHex(idb, 8L);
        String dir #= this.uploads + "/" + id;
        Path d #= Path.of(dir);
        d.mkdirs();
        return heap FilesystemMultipart(this, file, contentType, dir);
    }

    public #CondResult putIfAbsent(String key, int8[] bytes, String contentType) {
        String file #= this.fileOf(key, "putIfAbsent");
        LockGuard g #= this.lock.acquire();
        int8[] cur #= File.readAllBytes(file);
        if (cur != null) {
            String et #= FilesystemObjectStore.headerField(cur, 2);
            return heap CondResult(false, #et);
        }
        String etag #= this.install(file, bytes, bytes.count(), contentType);
        return heap CondResult(true, #etag);
    }

    public #CondResult putIfMatch(String key, int8[] bytes, String contentType, String etag) {
        String file #= this.fileOf(key, "putIfMatch");
        LockGuard g #= this.lock.acquire();
        int8[] cur #= File.readAllBytes(file);
        if (cur == null) {
            String none #= "" + "";
            return heap CondResult(false, #none);
        }
        String have #= FilesystemObjectStore.headerField(cur, 2);
        if (!have.equals(etag)) return heap CondResult(false, #have);
        String fresh #= this.install(file, bytes, bytes.count(), contentType);
        return heap CondResult(true, #fresh);
    }

    // ── package: writers and multipart install through here ─────────

    /** Install `len` bytes as the object at `file` with one temp-and-rename. */
    #String installLocked(String file, int8[] bytes, int64 len, String contentType) {
        LockGuard g #= this.lock.acquire();
        return this.install(file, bytes, len, contentType);
    }

    private #String install(String file, int8[] bytes, int64 len, String contentType) {
        int8[] rnd #= SecureRandom.bytes(8L);
        String hex #= HmacSha256.toHex(rnd, 8L);
        String etag #= "\"" + hex + "\"";
        String ct #= FilesystemObjectStore.oneLine(contentType);
        String header #= FilesystemObjectStore.MAGIC + "\n" + ct + "\n" + etag + "\n" + Clock.millisTime() + "\n";
        int64 h = (int64) header.byteLength();
        int8[] out = heap int8[h + len];
        for (int32 i = 0; i < (int32) h; i++) out[i] = header.byteAt(i);
        for (int64 i = 0L; i < len; i++) out[h + i] = bytes[i];
        Path parent #= Path.of(file).parent();
        parent.mkdirs();
        File.writeAllBytes(file, out, h + len);
        return #etag;
    }

    // Every key under `dir`, decoded, inserted in byte order.
    private void walk(String dir, String keyPrefix, ArrayList<String> into) {
        Path d #= Path.of(dir);
        if (!d.isDir()) return;
        ArrayList<Path> children #= d.list();
        for (int32 i = 0; i < children.count(); i++) {
            Path c = children.get(i);
            String name #= c.name();
            int32 n = name.byteLength();
            if (n < 2) continue;
            String suffix #= name.substring(n - 2, n);
            String seg #= name.substring(0, n - 2);
            String plain #= FilesystemObjectStore.decode(seg);
            String path #= c.toString();
            if (suffix.equals("=d") && c.isDir()) {
                String sub #= keyPrefix + plain + "/";
                this.walk(path, sub, into);
            } else if (suffix.equals("=o") && c.isFile()) {
                String key #= keyPrefix + plain;
                int32 at = 0;
                while (at < into.count() && FilesystemObjectStore.less(into.get(at), key)) at = at + 1;
                into.insert(at, #key);
            }
        }
    }

    private #String fileOf(String key, String operation) {
        String rel #= FilesystemObjectStore.relative(key, operation);
        return this.objects + "/" + rel;
    }

    // "a/b.txt" -> "a=d/b%2Etxt=o"; refuses an empty key and . or .. segments.
    private static #String relative(String key, String operation) {
        int32 n = key.byteLength();
        if (n == 0) FilesystemObjectStore.badKey(operation, key, "the key is empty");
        String out #= "" + "";
        int32 start = 0;
        for (int32 i = 0; i <= n; i++) {
            if (i == n || key.byteAt(i) == (int8) 47) {
                String seg #= key.substring(start, i);
                if (seg.equals(".") || seg.equals("..")) {
                    FilesystemObjectStore.badKey(operation, key, "a key segment may not be '.' or '..'");
                }
                String enc #= FilesystemObjectStore.encode(seg);
                if (enc.byteLength() > 240) {
                    FilesystemObjectStore.badKey(operation, key, "a key segment is too long for a file name");
                }
                if (i == n) out #= out + enc + "=o";
                else out #= out + enc + "=d/";
                start = i + 1;
            }
        }
        return #out;
    }

    private static void badKey(String operation, String key, String why) {
        throw heap CloudException(CloudException.PROVIDER_ERROR(), "filesystem", operation, key,
            "refused key: " + why);
    }

    private void notFound(String operation, String key) {
        this.statsObj.recordCall(0L, 0L, 0L, true);
        throw heap CloudException(CloudException.NOT_FOUND(), "filesystem", operation, key, "no such object");
    }

    // Lowercase letters, digits, '-' and '_' stay; every other byte is %XX.
    private static #String encode(String s) {
        int32 n = s.byteLength();
        int8[] out = heap int8[n * 3 + 1];
        int32 o = 0;
        for (int32 i = 0; i < n; i++) {
            int32 c = ((int32) s.byteAt(i)) & 0xff;
            if ((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95) {
                out[o] = (int8) c;
                o = o + 1;
            } else {
                out[o] = (int8) 37;
                out[o + 1] = FilesystemObjectStore.hexDigit(c >> 4);
                out[o + 2] = FilesystemObjectStore.hexDigit(c & 15);
                o = o + 3;
            }
        }
        return heap String(#out, o);
    }

    private static #String decode(String s) {
        int32 n = s.byteLength();
        int8[] out = heap int8[n < 1 ? 1 : n];
        int32 o = 0;
        int32 i = 0;
        while (i < n) {
            int8 c = s.byteAt(i);
            if (c == (int8) 37 && i + 2 < n) {
                out[o] = (int8) ((FilesystemObjectStore.hexValue(s.byteAt(i + 1)) << 4)
                    | FilesystemObjectStore.hexValue(s.byteAt(i + 2)));
                i = i + 3;
            } else {
                out[o] = c;
                i = i + 1;
            }
            o = o + 1;
        }
        return heap String(#out, o);
    }

    private static int8 hexDigit(int32 v) {
        if (v < 10) return (int8) (48 + v);
        return (int8) (55 + v);
    }

    private static int32 hexValue(int8 c) {
        if (c >= (int8) 48 && c <= (int8) 57) return (int32) c - 48;
        if (c >= (int8) 97 && c <= (int8) 102) return (int32) c - 87;
        return (int32) c - 55;
    }

    // Bytes before the payload: four header lines.
    static int64 headerLength(int8[] all) {
        return FilesystemObjectStore.headerLengthIn(all, all.count());
    }

    static int64 headerLengthIn(int8[] b, int64 n) {
        int32 lines = 0;
        for (int64 i = 0L; i < n; i++) {
            if (b[i] == (int8) 10) {
                lines = lines + 1;
                if (lines == 4) return i + 1L;
            }
        }
        return n;
    }

    // Header line `index` (0 is the magic, 1 content type, 2 etag, 3 modified).
    static #String headerField(int8[] all, int32 index) {
        int64 n = FilesystemObjectStore.headerLength(all);
        int32 line = 0;
        int64 start = 0L;
        for (int64 i = 0L; i < n; i++) {
            if (all[i] == (int8) 10) {
                if (line == index) {
                    int64 len = i - start;
                    int8[] out = heap int8[len < 1L ? 1L : len];
                    for (int64 j = 0L; j < len; j++) out[j] = all[start + j];
                    return heap String(#out, (int32) len);
                }
                line = line + 1;
                start = i + 1L;
            }
        }
        return "" + "";
    }

    private static #String oneLine(String s) {
        int32 n = s.byteLength();
        int8[] out = heap int8[n < 1 ? 1 : n];
        for (int32 i = 0; i < n; i++) {
            int8 c = s.byteAt(i);
            if (c == (int8) 10 || c == (int8) 13) c = (int8) 32;
            out[i] = c;
        }
        return heap String(#out, n);
    }

    static int64 number(String s) {
        int64 v = 0L;
        for (int32 i = 0; i < s.byteLength(); i++) {
            int32 c = (int32) s.byteAt(i);
            if (c < 48 || c > 57) return v;
            v = v * 10L + (int64) (c - 48);
        }
        return v;
    }

    static boolean less(String a, String b) {
        int32 n = a.byteLength();
        int32 m = b.byteLength();
        int32 k = n < m ? n : m;
        for (int32 i = 0; i < k; i++) {
            int32 x = ((int32) a.byteAt(i)) & 0xff;
            int32 y = ((int32) b.byteAt(i)) & 0xff;
            if (x != y) return x < y;
        }
        return n < m;
    }

    static int64 indexAfterPrefix(String k, String prefix, String delimiter) {
        int64 from = (int64) prefix.byteLength();
        int64 rel = k.indexOfFrom(delimiter, from);
        if (rel < 0L) return -1L;
        return rel;
    }
}
