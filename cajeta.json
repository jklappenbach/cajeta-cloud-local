{
    // cajeta-cloud-local — the filesystem object store for dev.cajeta.cloud's
    // object-store port (cajeta-cloud-adapters spec §4): every key a file
    // under one root directory, for development and tests with no account
    // and no network. Dev-grade: conditional writes are correct for one
    // process (spec §4.1, §4.3).
    //
    // Capabilities: `filesystem` for the root.

    "details": {
        "name":               "dev.cajeta.cloud.local",
        "version":            "0.1.0",
        "description":        "cajeta-cloud-local — a filesystem object store for dev.cajeta.cloud, dev-grade",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        "toolchain": {
            "version": "0.46.3"
        },

        "capabilities": ["filesystem"],

        "dependencies": {
            "dev.cajeta.cloud":  "0.4.1",
            "dev.cajeta.crypto": "0.2.0"
        },

        "dev-dependencies": {
            "dev.cajeta.unit": "0.3.6"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm", "args": ["-rf", "build"] }
            ]
        }
    }
}
